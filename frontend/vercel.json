{
  "version": 2,
  "buildCommand": "node node_modules/@angular/cli/bin/ng build",
  "outputDirectory": "dist/frontend/browser",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://VOTRE_APP_BACKEND.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
